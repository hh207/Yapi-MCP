# Yapi项目配置

# Server configuration
PORT=3388

# Token配置
# 多项目Token格式: projectId:token,projectId:token
YAPI_TOKEN=projectId:your_yapi_token_here,projectId2:your_yapi_token2_here

# 项目基础URL
YAPI_BASE_URL=your_yapi_base_url_here

# 缓存时效(分钟)，默认10分钟(6小时)
YAPI_CACHE_TTL=10

# 日志级别: debug, info, warn, error, none
# - debug: 输出所有日志，包括详细的调试信息
# - info: 输出信息、警告和错误日志(默认)
# - warn: 只输出警告和错误日志
# - error: 只输出错误日志
# - none: 不输出任何日志
YAPI_LOG_LEVEL=info

# YApi 登录账号（可选）
# YApi 的 up_cat / del_cat 接口只认登录态 Cookie，不接受项目 token。
# 需要批量修改或批量删除分类时，请配置下面的账号与密码，MCP 会自动登录并在登录态失效时重新登录。
# 未配置时，新增分类、查看/搜索分类仍可正常使用。
YAPI_LOGIN_EMAIL=your_yapi_login_email_here
YAPI_LOGIN_PASSWORD=your_yapi_login_password_here